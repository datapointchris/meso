# Caddyfile baked into the meso-web image.
#
# The edge proxy forwards the public hostname to this container on :80, after
# Authelia's ForwardAuth check, and this container splits paths between the API
# and the static SPA.

:80 {
	encode gzip

	# Liveness/readiness — used by the docker-compose healthcheck and any
	# orchestrator's probes.
	# Unauthenticated and identical across tiers. Wrapped in `handle` so it
	# terminates routing before the SPA fallback catches it.
	handle /health {
		respond "ok" 200
	}

	# The API's routes, and the RFC 9728 metadata `meso auth login <url>` reads
	# before it holds a token. The rest of /.well-known goes there too, so no
	# document under it is answered with the SPA's page.
	@api path /api/* /.well-known/*
	handle @api {
		reverse_proxy api:8088
	}

	# The build names each file here by a hash of its content, so a file is
	# cached for a year. A name no release holds answers 404 rather than the
	# page, which a tab still running an older release would otherwise parse
	# as a script and keep for that year.
	handle /assets/* {
		root * /srv/dist
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path is the one page, since Vue Router owns the client routes.
	# It revalidates, so a release shows promptly.
	handle {
		root * /srv/dist
		try_files {path} /index.html
		file_server
		header Cache-Control "public, max-age=300, must-revalidate"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "interest-cohort=(), geolocation=(), microphone=(), camera=()"
		# Self-contained SPA: no external origins. 'unsafe-inline' style is required
		# for Vite's injected component styles; scripts stay 'self' only.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
